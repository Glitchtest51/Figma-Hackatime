  "description": "A Plugin that adds support for Figma to HackaTime",
  "main": "build/code.js",
  "scripts": {
    "build": "esbuild src/ts/code.ts --bundle --outfile=build/code.js",
    "watch": "esbuild src/ts/code.ts --bundle --outfile=build/code.js --watch",
